<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="chefPro.Views.vInicio"
             x:Name="PageRoot"
             Title="Inicio"
             BackgroundColor="#CCFFF5EE"
             Padding="0">

    <Grid RowDefinitions="Auto,*,Auto">


        <!-- Overlay semitransparente opcional para mejor legibilidad -->
        <BoxView Grid.RowSpan="3"
             Color="#80FFFFFF"
             Opacity="0.3"/>

        <!-- HEADER -->
        <Frame Grid.Row="0"
               BackgroundColor="White"
               CornerRadius="0"
               Padding="15,10"
               HasShadow="True"
               Margin="0,0,0,10">

            <Grid ColumnDefinitions="*,Auto">
                <!-- Título -->
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="Descubre Recetas"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="Black"/>
                    <Label x:Name="NombreUsuarioLabel"
                           FontSize="14"
                           TextColor="Gray"/>
                </VerticalStackLayout>

                <!-- Botón cerrar sesión -->
                <Button Grid.Column="1"
                        Text="⏻"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        FontSize="24"
                        WidthRequest="50"
                        HeightRequest="50"
                        CornerRadius="25"
                        Clicked="CerrarSesion_Clicked"
                        VerticalOptions="Center"/>
            </Grid>
        </Frame>

        <!-- LISTA DE RECETAS -->
        <ScrollView Grid.Row="1" Padding="15,0">
            <VerticalStackLayout Spacing="15">

                <!-- Filtros rápidos -->
                <!-- <HorizontalStackLayout Spacing="10" Margin="0,0,0,10">
                    <Button Text="Todas"
                            BackgroundColor="#FF6600"
                            TextColor="White"
                            CornerRadius="20"
                            Padding="15,8"
                            FontSize="14"/>
                    <Button Text="Categorías ▼"
                            BackgroundColor="White"
                            TextColor="Black"
                            BorderColor="#E0E0E0"
                            BorderWidth="1"
                            CornerRadius="20"
                            Padding="15,8"
                            FontSize="14"/>
                    <Button Text="Precio ▼"
                            BackgroundColor="White"
                            TextColor="Black"
                            BorderColor="#E0E0E0"
                            BorderWidth="1"
                            CornerRadius="20"
                            Padding="15,8"
                            FontSize="14"/>
                </HorizontalStackLayout> -->

                <!-- COLLECTION VIEW CON CARDS -->
                <CollectionView ItemsSource="{Binding ListaRecetas}"
                    SelectionMode="None">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" 
                              ItemSpacing="15"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="White"
                                   CornerRadius="15"
                                   Padding="0"
                                   Margin="10,0"
                                   HasShadow="True">

                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRecetaSeleccionada"
                                          CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>

                                <Grid RowDefinitions="200,Auto">

                                    <!-- IMAGEN DE LA RECETA -->
                                    <Grid Grid.Row="0">
                                        <Image Source="{Binding FotoUrlCompleta}"
                                           Aspect="AspectFill"
                                           HeightRequest="200"/>

                                        <!-- Favorito en la esquina -->
                                        <Frame BackgroundColor="#80000000"
                                           CornerRadius="20"
                                           Padding="8"
                                           WidthRequest="40"
                                           HeightRequest="40"
                                           HorizontalOptions="End"
                                           VerticalOptions="Start"
                                           Margin="10"
                                           HasShadow="False">
                                            <Label Text="♡"
                                               FontSize="20"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                        </Frame>

                                        <!-- BOTONES DE EDITAR Y ELIMINAR (Solo si es del usuario) -->
                                        <HorizontalStackLayout HorizontalOptions="Start"
                                             VerticalOptions="Start"
                                             Spacing="5"
                                             Margin="10"
                                             IsVisible="{Binding UsuarioActual}">

                                            <!-- Botón Editar -->
                                            <Frame BackgroundColor="#FF6600"
                                               CornerRadius="20"
                                               Padding="8"
                                               WidthRequest="40"
                                               HeightRequest="40"
                                               HasShadow="True">
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnEditarReceta"
                                                                    CommandParameter="{Binding .}"/>
                                                </Frame.GestureRecognizers>
                                                <Label Text="✏️"
                                                   FontSize="18"
                                                   TextColor="White"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                            </Frame>

                                            <!-- Botón Eliminar -->
                                            <Frame BackgroundColor="#FF3B30"
                                               CornerRadius="20"
                                               Padding="8"
                                               WidthRequest="40"
                                               HeightRequest="40"
                                               HasShadow="True">
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnEliminarReceta"
                                                                    CommandParameter="{Binding .}"/>
                                                </Frame.GestureRecognizers>
                                                <Label Text="🗑️"
                                                   FontSize="18"
                                                   TextColor="White"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                            </Frame>

                                        </HorizontalStackLayout>
                                    </Grid>

                                    <!-- INFO DE LA RECETA (sin cambios) -->
                                    <VerticalStackLayout Grid.Row="1" Padding="15" Spacing="8">
                                        <!-- Tu código existente aquí -->
                                        <Label Text="{Binding titulo}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="Black"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"/>

                                        <Label Text="{Binding descripcion}"
                                           FontSize="13"
                                           TextColor="#666666"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"
                                           Margin="0,0,0,8"/>

                                        <HorizontalStackLayout Spacing="15" Margin="0,0,0,8">
                                            <HorizontalStackLayout Spacing="5">
                                                <Label Text="⏱️" FontSize="14" VerticalOptions="Center"/>
                                                <Label Text="{Binding tiempo_preparacion, StringFormat='{0} min'}"
                                                   FontSize="13" TextColor="#666666" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="5">
                                                <Label Text="🍽️" FontSize="14" VerticalOptions="Center"/>
                                                <Label Text="{Binding porciones, StringFormat='{0} porciones'}"
                                                    FontSize="13" TextColor="#666666" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </HorizontalStackLayout>

                                        <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,5"/>

                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5">
                                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                                <Label Text="Precio de Venta" FontSize="11" TextColor="#999999"/>
                                                <Label Text="{Binding valor_venta, StringFormat='${0:F2}'}"
                                                   FontSize="22" FontAttributes="Bold" TextColor="#FF6600" VerticalOptions="Center"/>
                                            </VerticalStackLayout>

                                            <Frame Grid.Row="0" Grid.Column="1"
                                               BackgroundColor="#E8F5E9" BorderColor="#4CAF50"
                                               CornerRadius="8" Padding="8,4" HasShadow="False" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="📈" FontSize="12" VerticalOptions="Center"/>
                                                    <Label Text="{Binding porcentaje_ganancia, StringFormat='+{0:F1}%'}"
                                                       FontSize="13" FontAttributes="Bold" TextColor="#4CAF50" VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </Frame>

                                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="5">
                                                <Label Text="Costo:" FontSize="12" TextColor="#999999" VerticalOptions="Center"/>
                                                <Label Text="{Binding costo_receta, StringFormat='${0:F2}'}"
                                                   FontSize="13" FontAttributes="Bold" TextColor="#666666" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="5">
                                                <Label Text="Por porción:" FontSize="12" TextColor="#999999" VerticalOptions="Center"/>
                                                <Label Text="{Binding precio_unidad, StringFormat='${0:F2}'}"
                                                   FontSize="13" FontAttributes="Bold" TextColor="#FF6600" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Grid.Row="2" Spacing="6">
                                                <Label Text="👤" FontSize="14" VerticalOptions="Center"/>
                                                <Label Text="{Binding nombre_usuario}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="#333333"
                                                       VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>

                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTTOM NAVIGATION BAR -->
        <Grid Grid.Row="2"
              BackgroundColor="White"
              Padding="10,8"
              ColumnDefinitions="*,*,*,*"
              RowDefinitions="50"
              ColumnSpacing="5">

            <!-- Botón Crear Receta -->
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Button Text="🍳"
                        FontSize="24"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        Padding="0"
                        HeightRequest="32"
                        Clicked="CrearReceta_Clicked"/>
                <Label Text="Crear"
                       FontSize="11"
                       TextColor="Gray"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Botón Ingredientes -->
            <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Button Text="🧂"
                        FontSize="24"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        Padding="0"
                        HeightRequest="32"
                        Clicked="btnIngredientes_Clicked"/>
                <Label Text="Ingredientes"
                       FontSize="11"
                       TextColor="Gray"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Botón Buscar -->
            <VerticalStackLayout Grid.Column="2" Spacing="2">
                <Button Text="🔍"
                        FontSize="24"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        Padding="0"
                        HeightRequest="32"
                        Clicked="BuscarReceta_Clicked"/>
                <Label Text="Buscar"
                       FontSize="11"
                       TextColor="Gray"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Botón Estadísticas -->
            <VerticalStackLayout Grid.Column="3" Spacing="2">
                <Button Text="📈"
                        FontSize="24"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        Padding="0"
                        HeightRequest="32"
                        Clicked="btnEstadisticas_Clicked"/>
                <Label Text="Estadísticas"
                       FontSize="11"
                       TextColor="Gray"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </Grid>

    </Grid>
</ContentPage>