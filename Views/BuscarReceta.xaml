<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2021/maui/toolkit"
             x:Class="chefPro.Views.BuscarReceta"
             Title="Buscar Receta"
             BackgroundColor="#FFE0C4">

    <Grid>

        <!-- FONDO -->
        <Image Source="buscar.jpg"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <Grid RowDefinitions="Auto,*">

            <!-- BOTÓN DE REGRESO -->
            <Button 
                Text="⬅️"
                BackgroundColor="Transparent"
                TextColor="#FF6600"
                FontSize="26"
                WidthRequest="48"
                HeightRequest="48"
                CornerRadius="25"
                Clicked="BtnRegresar_Clicked"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Margin="12"/>

            <!-- CONTENIDO -->
            <ScrollView Grid.Row="1" Padding="15">

                <VerticalStackLayout Spacing="18">

                    <!-- CARD SUPERIOR -->
                    <Frame BackgroundColor="#E6FFF5E8"
                           CornerRadius="22"
                           HasShadow="True"
                           Padding="18"
                           HorizontalOptions="FillAndExpand">

                        <VerticalStackLayout Spacing="18">

                            <!-- TÍTULO -->
                            <Label Text="Buscar Receta"
                                   FontAttributes="Bold"
                                   FontSize="28"
                                   HorizontalOptions="Center"
                                   TextColor="#FF6600"/>

                            <!-- CAMPO DE BÚSQUEDA -->
                            <material:TextField
                                x:Name="txtBusqueda"
                                Title="Título de la Receta"
                                TextColor="Black"
                                TitleColor="#FF6600"
                                BorderColor="#FF6600"
                                BackgroundColor="Transparent" />

                            <!-- BOTÓN BUSCAR -->
                            <Button Text="Buscar"
                                    Clicked="BtnBuscar_Clicked"
                                    BackgroundColor="#FF6600"
                                    CornerRadius="15"
                                    HeightRequest="48"
                                    FontSize="16"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    WidthRequest="220"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- COLLECTIONVIEW DE RESULTADOS -->
                    <CollectionView x:Name="ResultadosList"
                                    SelectionMode="None"
                                    IsVisible="False"
                                    Margin="0">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <!-- CARD DE RESULTADO -->
                                <Frame Padding="12"
                                       BackgroundColor="#FFE0DB"
                                       CornerRadius="20"
                                       HasShadow="True"
                                       HorizontalOptions="FillAndExpand"
                                       IsClippedToBounds="True">

                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="Receta_Tap"
                                                              CommandParameter="{Binding}"/>
                                    </Frame.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="10">

                                        <!-- IMAGEN -->
                                        <Frame Grid.Column="0"
                                               Padding="0"
                                               CornerRadius="15"
                                               HeightRequest="100"
                                               WidthRequest="100"
                                               HasShadow="True"
                                               BackgroundColor="White">

                                            <Image Source="{Binding foto_url}"
                                                   Aspect="AspectFill"
                                                   HeightRequest="100"
                                                   WidthRequest="100">
                                                <Image.Clip>
                                                    <RoundRectangleGeometry CornerRadius="15"
                                                                            Rect="0,0,100,100" />
                                                </Image.Clip>
                                            </Image>
                                        </Frame>

                                        <!-- INFORMACIÓN -->
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="6"
                                                             HorizontalOptions="FillAndExpand">

                                            <Label Text="{Binding titulo}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="Black"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation"/>

                                            <Label Text="{Binding descripcion}"
                                                   FontSize="13"
                                                   TextColor="Black"
                                                   MaxLines="2"
                                                   LineBreakMode="TailTruncation"/>

                                            <!-- DATOS CON FLEX (AJUSTE AUTOMÁTICO) -->
                                            <FlexLayout Wrap="Wrap"
                                                        Direction="Row"
                                                        AlignItems="Center"
                                                        JustifyContent="Start"
                                                        Margin="0,4,0,0"
                                                        HorizontalOptions="FillAndExpand">

                                                <!-- TIEMPO -->
                                                <HorizontalStackLayout Spacing="4" Margin="0,0,8,6">
                                                    <Label Text="⏱" FontSize="13"/>
                                                    <Label Text="{Binding tiempo_preparacion, StringFormat='{0} min'}"
                                                           FontSize="13"
                                                           TextColor="Black"/>
                                                </HorizontalStackLayout>

                                                <!-- PORCIONES -->
                                                <HorizontalStackLayout Spacing="4" Margin="0,0,8,6">
                                                    <Label Text="🍽" FontSize="13"/>
                                                    <Label Text="{Binding porciones}"
                                                           FontSize="13"
                                                           TextColor="Black"/>
                                                </HorizontalStackLayout>

                                                <!-- VALOR -->
                                                <HorizontalStackLayout Spacing="4" Margin="0,0,8,6">
                                                    <Label Text="💲" FontSize="13"/>
                                                    <Label Text="{Binding valor_venta, StringFormat='{0:C2}'}"
                                                           FontSize="13"
                                                           TextColor="Black"/>
                                                </HorizontalStackLayout>

                                                <!-- COSTO -->
                                                <HorizontalStackLayout Spacing="4" Margin="0,0,8,6">
                                                    <Label Text="💰" FontSize="13"/>
                                                    <Label Text="{Binding costo_receta, StringFormat='{0:C2}'}"
                                                           FontSize="13"
                                                           TextColor="Black"/>
                                                </HorizontalStackLayout>

                                            </FlexLayout>

                                        </VerticalStackLayout>

                                    </Grid>

                                </Frame>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>

            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
