<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:m="clr-namespace:UraniumUI.Icons.MaterialIcons;assembly=UraniumUI.Icons.MaterialIcons"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2021/maui/toolkit"
             xmlns:validation="clr-namespace:InputKit.Shared.Validations;assembly=InputKit.Maui"
             xmlns:input="clr-namespace:InputKit.Shared.Controls;assembly=InputKit.Maui"
             x:Class="chefPro.Views.vLogin">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Entrada de texto con fondo blanco -->
            <Style x:Key="entradaTexto" TargetType="material:TextField">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="#333333" />
                <Setter Property="TitleColor" Value="#666666"/>
                <Setter Property="FontSize" Value="16" />
                <Setter Property="BorderColor" Value="#DDDDDD" />
                <Setter Property="Margin" Value="0,5" />
            </Style>

            <!-- Botón de Login -->
            <Style x:Key="buttonLogin" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#FF6600" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="50" />
            </Style>

            <!-- Botón de Registro -->
            <Style x:Key="buttonRegister" TargetType="Button">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="#FF6600" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="BorderColor" Value="#FF6600" />
                <Setter Property="BorderWidth" Value="2" />
            </Style>

            <!-- Botón de Login con Google -->
            <Style x:Key="buttonLoginGoogle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="#333" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="BorderColor" Value="#DDD" />
                <Setter Property="BorderWidth" Value="1" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Imagen de fondo -->
        <Image Source="fondo_cocina.jpg"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"/>

        <!-- Overlay oscuro para mejor legibilidad -->
        <BoxView BackgroundColor="#99000000"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill"/>

        <!-- Gradiente blanco en la parte superior -->
        <BoxView HorizontalOptions="Fill"
                 VerticalOptions="Fill">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#EEFFFFFF" Offset="0.0" />
                    <GradientStop Color="#CCFFFFFF" Offset="0.2" />
                    <GradientStop Color="#66FFFFFF" Offset="0.35" />
                    <GradientStop Color="Transparent" Offset="0.55" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <ScrollView>
            <!-- Contenido centrado -->
            <VerticalStackLayout Padding="40,50" Spacing="15" VerticalOptions="Center">

                <!-- Logo / Título -->
                <Image Source="chefpro_logo.png"
                       HeightRequest="120"
                       HorizontalOptions="Center"
                       Margin="0,0,0,10"/>

                <Label Text="ChefPro"
                       FontAttributes="Bold"
                       FontSize="40"
                       TextColor="#FF6600"
                       HorizontalOptions="Center" />

                <Label Text="¡Bienvenido de nuevo!"
                   FontAttributes="Bold"
                   FontSize="24"
                   TextColor="#1E1E1E"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20">
                    <Label.Shadow>
                        <Shadow Brush="White"
                            Opacity="0.8"
                            Radius="10"
                            Offset="0,0" />
                    </Label.Shadow>
                </Label>

                <!-- Card contenedor para los campos -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="25,20"
                        Margin="0,10"
                        StrokeShape="RoundRectangle 15">
                    <Border.Shadow>
                        <Shadow Brush="Black"
                                Opacity="0.2"
                                Radius="10"
                                Offset="0,5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">

                        <!-- Email -->
                        <material:TextField 
                            Style="{StaticResource entradaTexto}"
                            Title="Correo Electrónico"
                            x:Name="txtEmail"
                            TextColor="#333"
                            Keyboard="Email"
                            FontSize="14"
                            Icon="{FontImageSource FontFamily=MaterialRegular, Glyph={x:Static m:MaterialRegular.Email}, Color=#666}"
                            AccentColor="#FB8C00">
                            <validation:RequiredValidation Message="El correo es obligatorio" />
                            <validation:RegexValidation Pattern="{x:Static input:AdvancedEntry.REGEX_EMAIL}" Message="Email inválido" />
                        </material:TextField>

                        <!-- Password -->
                        <material:TextField 
                            x:Name="txtPassword" 
                            Style="{StaticResource entradaTexto}"
                            Title="Contraseña" 
                            TextColor="#333"
                            IsPassword="True"
                            AccentColor="#FB8C00">
                            <material:TextField.Attachments>
                                <material:TextFieldPasswordShowHideAttachment />
                            </material:TextField.Attachments>
                            <validation:RequiredValidation Message="La contraseña es obligatoria" />
                        </material:TextField>

                    </VerticalStackLayout>
                </Border>

                <!-- Botón de Login -->
                <Button
                    x:Name="btnLogin"
                    Style="{StaticResource buttonLogin}"
                    Text="Iniciar Sesión"
                    Margin="0,10,0,0"
                    Clicked="btnLogin_Clicked">
                    <Button.Shadow>
                        <Shadow Brush="Black"
                                Opacity="0.3"
                                Radius="10"
                                Offset="0,5" />
                    </Button.Shadow>
                </Button>

                <!-- Separador -->
                <Label Text="O"
                       FontAttributes="Bold"
                       FontSize="14"
                       TextColor="#fff"
                       HorizontalOptions="Center"
                       Margin="0,5" />

                <!-- Botón de Registro -->
                <Button 
                    x:Name="btnRegister"
                    Style="{StaticResource buttonRegister}"
                    Text="Crear una cuenta"
                    Clicked="btnRegister_Clicked">
                    <Button.Shadow>
                        <Shadow Brush="Black"
                                Opacity="0.15"
                                Radius="8"
                                Offset="0,3" />
                    </Button.Shadow>
                </Button>

                <!-- Botón de Google -->
                <Button 
                    x:Name="btnLoginGoogle"
                    Style="{StaticResource buttonLoginGoogle}"
                    ImageSource="logo_google.png"
                    IsVisible="False"
                    Text="Iniciar con Google"
                    Clicked="btnLoginGoogle_Clicked"
                    Margin="0,5,0,0"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>