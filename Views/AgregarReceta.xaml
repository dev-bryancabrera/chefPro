<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="chefPro.Views.AgregarReceta"
             x:Name="PageRoot"
             Title="Agregar Receta"
             BackgroundColor="#FFD9B3">

    <Grid>
        <Image Source="receta.jpg"
               Aspect="AspectFill"
               HorizontalOptions="FillAndExpand"
               VerticalOptions="FillAndExpand"/>

        <ScrollView>
            <VerticalStackLayout Padding="15" Spacing="18">

                <Label Text="Agregar Receta"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="#FF6600"
                       Margin="0,10,0,0"/>

                <Frame BackgroundColor="#FFE6D5"
                       CornerRadius="25"
                       Padding="20"
                       HorizontalOptions="Fill"
                       HasShadow="True">

                    <VerticalStackLayout Spacing="18">

                        <!-- TÍTULO -->
                        <Frame BackgroundColor="White"
                               BorderColor="#FF6600"
                               CornerRadius="12"
                               HorizontalOptions="Fill"
                               Padding="0">

                            <HorizontalStackLayout Spacing="5" Padding="8">
                                <Label Text="📝" FontSize="20" VerticalOptions="Center"/>
                                <Entry x:Name="txtTitulo"
                                       Placeholder="Título"
                                       HorizontalTextAlignment="Start"
                                       TextColor="Black"/>
                            </HorizontalStackLayout>
                        </Frame>

                        <!-- TIEMPO / PORCIONES / VALOR / % -->
                        <FlexLayout Wrap="Wrap"
                                    Direction="Row"
                                    JustifyContent="Center"
                                    AlignItems="Center"
                                    BindableLayout.ItemsSource="{x:Reference itemsTiempo}">

                            <!-- TIEMPO -->
                            <Frame BackgroundColor="White"
                                   BorderColor="#FF6600"
                                   CornerRadius="12"
                                   Padding="0"
                                   WidthRequest="150"
                                   Margin="5">

                                <HorizontalStackLayout Padding="5" Spacing="5">
                                    <Label Text="⏱️" FontSize="18" VerticalOptions="Center"/>
                                    <Entry x:Name="txtTiempo"
                                           Keyboard="Numeric"
                                           Placeholder="Tiempo"
                                           TextColor="Black"/>
                                </HorizontalStackLayout>
                            </Frame>

                            <!-- PORCIONES -->
                            <Frame BackgroundColor="White"
                                   BorderColor="#FF6600"
                                   CornerRadius="12"
                                   Padding="0"
                                   WidthRequest="150"
                                   Margin="5">

                                <HorizontalStackLayout Padding="5" Spacing="5">
                                    <Label Text="🍽️" FontSize="18"/>
                                    <Entry x:Name="txtPorciones"
                                           Keyboard="Numeric"
                                           Placeholder="Porciones"
                                           TextColor="Black"/>
                                </HorizontalStackLayout>
                            </Frame>

                            <!-- VALOR -->
                            <Frame BackgroundColor="White"
                                   BorderColor="#FF6600"
                                   CornerRadius="12"
                                   Padding="0"
                                   WidthRequest="150"
                                   Margin="5">

                                <HorizontalStackLayout Padding="5" Spacing="5">
                                    <Label Text="💲" FontSize="18"/>
                                    <Entry x:Name="txtValorVenta"
                                           Keyboard="Numeric"
                                           Placeholder="Valor venta"
                                           TextColor="Black"/>
                                </HorizontalStackLayout>
                            </Frame>

                            <!-- % -->
                            <Frame BackgroundColor="White"
                                   BorderColor="#FF6600"
                                   CornerRadius="12"
                                   Padding="0"
                                   WidthRequest="150"
                                   Margin="5">

                                <HorizontalStackLayout Padding="5" Spacing="5">
                                    <Label Text="📈" FontSize="18"/>
                                    <Entry x:Name="txtPorcentaje"
                                           Keyboard="Numeric"
                                           Placeholder="% Ganancia"
                                           TextColor="Black"/>
                                </HorizontalStackLayout>
                            </Frame>
                        </FlexLayout>

                        <!-- DESCRIPCIÓN -->
                        <Frame BackgroundColor="White"
                               BorderColor="#FF6600"
                               CornerRadius="12"
                               HeightRequest="70"
                               HorizontalOptions="Fill"
                               Padding="0">

                            <HorizontalStackLayout Padding="10" Spacing="10">
                                <Label Text="💬" FontSize="20"/>
                                <Entry x:Name="txtDescripcion"
                                       Placeholder="Descripción (máx. 80 caracteres)"
                                       TextColor="Black"
                                       MaxLength="80"/>
                            </HorizontalStackLayout>
                        </Frame>

                        <!-- INGREDIENTES -->
                        <Frame BackgroundColor="White"
       BorderColor="#FF6600"
       CornerRadius="12"
       Padding="12"
       HorizontalOptions="FillAndExpand">

                            <VerticalStackLayout Spacing="12">

                                <!-- Título + botón -->
                                <HorizontalStackLayout Spacing="10"
                               HorizontalOptions="FillAndExpand">

                                    <Label Text="🥕 Ingredientes"
                   FontAttributes="Bold"
                   FontSize="18"
                   TextColor="#FF6600"
                   VerticalOptions="Center" />

                                    <Button Text="➕ Agregar"
                    Clicked="BtnAgregarIngrediente_Clicked"
                    BackgroundColor="#FF884D"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="35"
                    FontSize="14"
                    HorizontalOptions="EndAndExpand"/>
                                </HorizontalStackLayout>


                                <!-- LISTA DE INGREDIENTES -->
                                <CollectionView x:Name="cvIngredientes">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>

                                            <!-- Contenedor -->
                                            <Frame BorderColor="#FF6600"
                           CornerRadius="10"
                           BackgroundColor="white"
                           Padding="8"
                           Margin="0,5"
                           HasShadow="False"
                           HorizontalOptions="FillAndExpand">

                                                <!-- GRID RESPONSIVE -->
                                                <Grid ColumnDefinitions="2*,1*,1.5*,1*,45"
                              ColumnSpacing="6"
                              HorizontalOptions="FillAndExpand"
                              VerticalOptions="Center">

                                                    <!-- Nombre -->
                                                    <Entry Grid.Column="0"
                                   Placeholder="Nombre"
                                   Text="{Binding nombre}"
                                   HeightRequest="30"
                                   TextColor="Black"
                                   BackgroundColor="White"
                                   FontSize="13"
                                   HorizontalOptions="FillAndExpand"/>

                                                    <!-- Cantidad -->
                                                    <Entry Grid.Column="1"
                                   Placeholder="Cant"
                                   Keyboard="Numeric"
                                   Text="{Binding cantidad}"
                                   HeightRequest="30"
                                   TextColor="Black"
                                   BackgroundColor="White"
                                   FontSize="13"
                                   HorizontalOptions="FillAndExpand"/>

                                                    <!-- Unidad -->
                                                    <Picker Grid.Column="2"
                                    ItemsSource="{Binding Source={x:Reference PageRoot}, Path=Unidades}"
                                    SelectedItem="{Binding unidad}"
                                    HeightRequest="30"
                                    BackgroundColor="White"
                                    FontSize="13"
                                    TextColor="Black"
                                    HorizontalOptions="FillAndExpand"/>

                                                    <!-- Precio -->
                                                    <Entry Grid.Column="3"
                                   Placeholder="$"
                                   Keyboard="Numeric"
                                   Text="{Binding precio}"
                                   HeightRequest="30"
                                   TextColor="Black"
                                   BackgroundColor="White"
                                   FontSize="13"
                                   HorizontalOptions="FillAndExpand"/>

                                                    <!-- Eliminar -->
                                                    <Button Grid.Column="4"
                                    Text="❌"
                                    CommandParameter="{Binding .}"
                                    Clicked="BtnEliminarIngrediente_Clicked"
                                    BackgroundColor="White"
                                    TextColor="#FF6600"
                                    CornerRadius="8"
                                    HeightRequest="30"
                                    FontSize="14"/>
                                                </Grid>

                                            </Frame>

                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                            </VerticalStackLayout>
                        </Frame>

                        <!-- INSTRUCCIONES -->
                        <Frame BackgroundColor="White"
                               BorderColor="#FF6600"
                               CornerRadius="12"
                               HorizontalOptions="Fill"
                               Padding="12">

                            <VerticalStackLayout Spacing="10">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="📜" FontSize="20"/>
                                    <Label Text="Instrucciones"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           TextColor="#FF6600"/>
                                </HorizontalStackLayout>

                                <Editor x:Name="txtInstrucciones"
                                        Placeholder="Escribe las instrucciones paso a paso"
                                        TextColor="Black"
                                        HeightRequest="150"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- FOTO -->
                        <Frame BackgroundColor="White"
                               BorderColor="#FF6600"
                               CornerRadius="12"
                               HorizontalOptions="Fill"
                               Padding="12">

                            <VerticalStackLayout Spacing="10">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="📷" FontSize="20"/>
                                    <Label Text="" FontAttributes="Bold" FontSize="18" TextColor="#FF6600"/>
                                </HorizontalStackLayout>

                                <Image x:Name="imgFoto"
                                       HeightRequest="250"
                                       Aspect="AspectFit"
                                       BackgroundColor="#EEE"
                                       HorizontalOptions="Center"/>

                                <Button Text="Tomar / Seleccionar Foto"
                                        Clicked="BtnFoto_Clicked"
                                        BackgroundColor="#FF884D"
                                        TextColor="White"
                                        CornerRadius="12"
                                        HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- BOTONES -->
                        <HorizontalStackLayout Spacing="12"
                                               HorizontalOptions="Center"
                                               Margin="0,10">
                            <Button Text="Guardar Receta"
                                    Clicked="BtnGuardarReceta_Clicked"
                                    BackgroundColor="#FF6600"
                                    TextColor="White"
                                    CornerRadius="12"
                                    WidthRequest="150"/>

                            <Button Text="Regresar"
                                    Clicked="BtnRegresar_Clicked"
                                    BackgroundColor="#FFB7AE"
                                    TextColor="Black"
                                    CornerRadius="12"
                                    WidthRequest="150"/>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>