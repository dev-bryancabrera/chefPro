<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/maui/toolkit"
             xmlns:input="clr-namespace:InputKit.Shared.Controls;assembly=InputKit.Maui"
             x:Class="chefPro.Views.AgregarReceta"
             Title="Agregar Receta"
             BackgroundColor="#FFF5EE">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <!--Recordar enlazar con login

            <Label x:Name="lblUsuarioActivo"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="#FF6600"
                   HorizontalOptions="End"-->


            <!-- TÍTULO GRANDE -->
            <Label Text="🍲 AGREGAR RECETA" 
                   FontSize="36" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="#FF6600"/>

            <!-- Título -->
            <Frame BackgroundColor="#FFF8F0" CornerRadius="20" HasShadow="True" Padding="15">
                <material:TextField x:Name="txtTitulo" 
                                    Title="🍴 Título de la Receta" 
                                    Icon="📝" 
                                    TextColor="Black" 
                                    TitleColor="#FF6600" 
                                    BorderColor="#FF6600" 
                                    BackgroundColor="Transparent"/>
            </Frame>

            <!-- Descripción -->
            <Frame BackgroundColor="#FFD1B3" CornerRadius="20" HasShadow="True" Padding="15">
                <Editor x:Name="txtDescripcion" 
                        TextColor="Black"
                        Placeholder="📝 Descripción (max 150 caracteres)" 
                        AutoSize="TextChanges" 
                        HeightRequest="80"/>
            </Frame>

            <!-- Instrucciones -->
            <Frame BackgroundColor="#FFD1B3" CornerRadius="20" HasShadow="True" Padding="15">
                <Editor x:Name="txtInstrucciones" 
                              TextColor="Black"
                        Placeholder="📖 Instrucciones paso a paso" 
                        AutoSize="TextChanges" 
                        HeightRequest="120"/>
            </Frame>

            <BoxView HeightRequest="1" BackgroundColor="#FF6600" Margin="0,10"/>

            <!-- Ingredientes -->
            <Frame BackgroundColor="#FFD1B3" CornerRadius="20" HasShadow="True" Padding="10">
                <VerticalStackLayout>
                    <Label Text="🥕 Ingredientes" FontAttributes="Bold" FontSize="16" TextColor="#FF6600"/>
                    <CollectionView x:Name="cvIngredientes" SelectionMode="None" HeightRequest="150">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <HorizontalStackLayout Spacing="10">
                                    <Entry Placeholder="Nombre" Text="{Binding nombre}" WidthRequest="120"/>
                                    <Entry Placeholder="Cantidad" Keyboard="Numeric" Text="{Binding cantidad}" WidthRequest="80"/>
                                    <Entry Placeholder="Unidad" Text="{Binding unidad}" WidthRequest="80"/>
                                    <Button Text="❌" Clicked="BtnEliminarIngrediente_Clicked" CommandParameter="{Binding .}" BackgroundColor="#FF6600" TextColor="White" CornerRadius="10" WidthRequest="50"/>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button Text="➕ Agregar Ingrediente" Clicked="BtnAgregarIngrediente_Clicked" BackgroundColor="#FF6600" TextColor="White" CornerRadius="15"/>
                </VerticalStackLayout>
            </Frame>
            <Label Text="Detalles:" VerticalOptions="Center"    FontSize="26"   TextColor="Black"/>
            <BoxView HeightRequest="1" BackgroundColor="#FF6600" Margin="0,10"/>

            <!-- Tiempo de preparación -->
            <Frame BackgroundColor="#FFD1B3" CornerRadius="20" HasShadow="True" Padding="15">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="⏱ Tiempo (min):" VerticalOptions="Center"      TextColor="Black"/>
                    <Entry x:Name="txtTiempo" Keyboard="Numeric" WidthRequest="80"      TextColor="Black"/>
                </HorizontalStackLayout>
            </Frame>

            <!-- Peso por porción -->
            <Frame BackgroundColor="#FFD1B3" CornerRadius="20" HasShadow="True" Padding="15">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="⚖️ Peso por porción (g):" VerticalOptions="Center"      TextColor="Black"/>
                    <Entry x:Name="txtPesoPorcion" Keyboard="Numeric" WidthRequest="80"       TextColor="Black"/>
                </HorizontalStackLayout>
            </Frame>

            <!-- Costo receta -->
            <Frame BackgroundColor="#FFD1B3" CornerRadius="20" HasShadow="True" Padding="15">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="💲 Costo receta ($):" VerticalOptions="Center"      TextColor="Black"/>
                    <Entry x:Name="txtCosto" Keyboard="Numeric" WidthRequest="80"      TextColor="Black"/>
                </HorizontalStackLayout>
            </Frame>

            <BoxView HeightRequest="1" BackgroundColor="#FF6600" Margin="0,10"/>

            <Frame BackgroundColor="#FFD1B3" CornerRadius="20" HasShadow="True" Padding="10">
                <VerticalStackLayout>
                    <Button Text="📸 Foto" Clicked="BtnFoto_Clicked" BackgroundColor="#FF6600" TextColor="White" CornerRadius="15"/>

                    <Image x:Name="imgFoto" HeightRequest="150" Aspect="AspectFill"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Botones Guardar / Regresar -->
            <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                <Button Text="💾 Guardar" Clicked="BtnGuardar_Clicked" BackgroundColor="#FF6600" TextColor="White" CornerRadius="15" WidthRequest="120"/>
                <Button Text="⬅️ Regresar" Clicked="BtnRegresar_Clicked" BackgroundColor="#AAAAAA" TextColor="White" CornerRadius="15" WidthRequest="120"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
