<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="chefPro.Views.AgregarReceta"
             x:Name="PageRoot"
             Title="Agregar Receta"
             BackgroundColor="#FFF5EE">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <!-- TÍTULO PRINCIPAL CENTRADO -->
            <Label Text="Agregar Receta"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="#FF6600"
                   Margin="0,10,0,0"/>

            <!-- BLOQUE PRINCIPAL -->
            <Frame BackgroundColor="White"
                   CornerRadius="25"
                   Padding="20"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HasShadow="True">

                <VerticalStackLayout Spacing="18">

                    <!-- TÍTULO DE LA RECETA -->
                    <Frame BackgroundColor="White"
                           BorderColor="#FF6600"
                           CornerRadius="12"
                           HorizontalOptions="Center"
                           WidthRequest="700"
                           Padding="0">
                        <HorizontalStackLayout Spacing="1" Padding="2">
                            <Label Text="    📝" FontSize="20" VerticalOptions="Center"/>
                            <Entry x:Name="txtTitulo"
                                   Placeholder="Título"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="Center"
                                   TextColor="Black"
                                   HeightRequest="25"/>
                        </HorizontalStackLayout>
                    </Frame>

                    <!-- TIEMPO / PORCIONES / VALOR / % GANANCIA -->
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Center">

                        <!-- Tiempo -->
                        <Frame BackgroundColor="White"
                               BorderColor="#FF6600"
                               CornerRadius="12"
                               Padding="0"
                               WidthRequest="120">
                            <HorizontalStackLayout Spacing="1" Padding="1">
                                <Label Text="  ⏱️" FontSize="20" VerticalOptions="Center"/>
                                <Entry x:Name="txtTiempo"
                                       Keyboard="Numeric"
                                       Placeholder="Tiempo"
                                       TextColor="Black"
                                       HeightRequest="25"/>
                            </HorizontalStackLayout>
                        </Frame>

                        <!-- Porciones -->
                        <Frame BackgroundColor="White"
                               BorderColor="#FF6600"
                               CornerRadius="12"
                               Padding="0"
                               WidthRequest="135">
                            <HorizontalStackLayout Spacing="1" Padding="1">
                                <Label Text="  🍽️" FontSize="20" VerticalOptions="Center"/>
                                <Entry x:Name="txtPorciones"
                                       Keyboard="Numeric"
                                       Placeholder="Porciones"
                                       TextColor="Black"
                                       HeightRequest="30"/>
                            </HorizontalStackLayout>
                        </Frame>

                        <!-- Valor Venta -->
                        <Frame BackgroundColor="White"
                               BorderColor="#FF6600"
                               CornerRadius="12"
                               Padding="0"
                               WidthRequest="145">
                            <HorizontalStackLayout Spacing="1" Padding="1">
                                <Label Text="  💲" FontSize="20" VerticalOptions="Center"/>
                                <Entry x:Name="txtValorVenta"
                                       Keyboard="Numeric"
                                       Placeholder="Valor venta"
                                       TextColor="Black"
                                       HeightRequest="30"/>
                            </HorizontalStackLayout>
                        </Frame>

                        <!-- % Ganancia -->
                        <Frame BackgroundColor="White"
                               BorderColor="#FF6600"
                               CornerRadius="12"
                               Padding="0"
                               WidthRequest="145">
                            <HorizontalStackLayout Spacing="1" Padding="1">
                                <Label Text=" 📈" FontSize="20" VerticalOptions="Center"/>
                                <Entry x:Name="txtPorcentaje"
                                       Keyboard="Numeric"
                                       Placeholder="% Ganancia"
                                       TextColor="Black"
                                       HeightRequest="25"/>
                            </HorizontalStackLayout>
                        </Frame>

                    </HorizontalStackLayout>

                    <!-- DESCRIPCIÓN -->
                    <Frame BackgroundColor="White"
                           BorderColor="#FF6600"
                           CornerRadius="12"
                           HeightRequest="66"
                           Padding="0">
                        <HorizontalStackLayout Spacing="10" Padding="12">
                            <Label Text="💬" FontSize="20" VerticalOptions="Center"/>
                            <Entry x:Name="txtDescripcion"
                                   Placeholder="Descripción (máx. 80 caracteres)"
                                   TextColor="Black"
                                   HeightRequest="25"
                                   MaxLength="80"/>
                        </HorizontalStackLayout>
                    </Frame>

<!-- INGREDIENTES -->
                    <Frame BackgroundColor="White"
                           BorderColor="#FF6600"
                           CornerRadius="12"
                           Padding="0">
                        <VerticalStackLayout Spacing="12">

                            <HorizontalStackLayout Spacing="1">
                                <Label Text="🥕" FontSize="2" VerticalOptions="Center"/>
                                <Label Text="Ingredientes"
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="#FF6600"/>
                            </HorizontalStackLayout>

                            <CollectionView x:Name="cvIngredientes">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <HorizontalStackLayout Spacing="6" Padding="5">

                                            <Entry Placeholder="Nombre"
                                                   Text="{Binding nombre}"
                                                   HeightRequest="25"
                                                   BackgroundColor="#FFE6D5"
                                                   TextColor="Black"
                                                   WidthRequest="100"/>

                                            <Entry Placeholder="Cant"
                                                   Text="{Binding cantidad, Mode=TwoWay}"
                                                   Keyboard="Numeric"
                                                   HeightRequest="25"
                                                   BackgroundColor="#FFE6D5"
                                                   TextColor="Black"
                                                   WidthRequest="75"/>

                                            <!-- PICKER FUNCIONAL -->
                                            <Picker 
                                                    ItemsSource="{Binding Source={x:Reference PageRoot}, Path=Unidades}"
                                                    SelectedItem="{Binding unidad, Mode=TwoWay}" 
                                                    WidthRequest="100"
                                                    BackgroundColor="#FFE6D5"
                                                    TextColor="Black"/>


                                            <Entry Placeholder="$"
                                                       Text="{Binding precio, Mode=TwoWay}"
                                                       Keyboard="Numeric"
                                                       HeightRequest="25"
                                                       TextColor="Black"
                                                       BackgroundColor="#FFE6D5"
                                                       WidthRequest="50"/>

                                            <Button Text="❌"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="BtnEliminarIngrediente_Clicked"
                                                    WidthRequest="40"
                                                    CornerRadius="10"
                                                    BackgroundColor="#FFE6D5"
                                                    TextColor="#FF6600"/>
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <Button Text="➕ Agregar Ingrediente"
                                    Clicked="BtnAgregarIngrediente_Clicked"
                                    BackgroundColor="#FF6600"
                                    TextColor="White"
                                    WidthRequest="250"
                                    CornerRadius="12"/>
                        </VerticalStackLayout>
                    </Frame>                   
                    <!-- INSTRUCCIONES -->
                    <Frame BackgroundColor="White"
                           BorderColor="#FF6600"
                           CornerRadius="12"
                           Padding="12">
                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="📜" FontSize="20" VerticalOptions="Center"/>
                                <Label Text="Instrucciones"
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="#FF6600"/>
                            </HorizontalStackLayout>

                            <Editor x:Name="txtInstrucciones"
                                    Placeholder="Escribe las instrucciones paso a paso"
                                    TextColor="Black"
                                    AutoSize="TextChanges"
                                    HeightRequest="120"/>
                        </VerticalStackLayout>
                    </Frame>

                
                    

                    <!-- FOTO -->
                    <Frame BackgroundColor="White"
                           BorderColor="#FF6600"
                           HorizontalOptions="Center"
                           CornerRadius="12"
                           Padding="12">    
                        <VerticalStackLayout Spacing="10">
                            <Image x:Name="imgFoto"
                               HeightRequest="300"
                                   Aspect="AspectFit"
                                   BackgroundColor="#EEE"/>
                                        <Button Text="📷 Tomar / Seleccionar Foto"
                                    BackgroundColor="#FFE6D5"
                                    TextColor="#FF6600"
                                    WidthRequest="300"
                                    CornerRadius="12"
                                    Clicked="BtnFoto_Clicked"/>
                        </VerticalStackLayout>
                    </Frame>

                    <HorizontalStackLayout Spacing="20" HorizontalOptions="Center" Padding="10">

                        <!-- Botón Guardar Receta -->
                        <Button Text="💾 Guardar Receta"
                            BackgroundColor="#FF6600"
                            TextColor="White"
                            WidthRequest="150"
                            CornerRadius="12"
                            Clicked="BtnGuardarReceta_Clicked"/>

                        <!-- Botón Regresar -->
                        <Button Text="⬅️ Regresar"
                            BackgroundColor="#FFE6D5"
                            TextColor="#FF6600"
                            WidthRequest="150"
                            CornerRadius="12"
                            Clicked="BtnRegresar_Clicked"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>