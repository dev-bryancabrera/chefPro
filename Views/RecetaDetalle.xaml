<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="chefPro.Views.RecetaDetalle"
             BackgroundColor="#FFF5EE">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER CON BOTONES -->
        <Frame Grid.Row="0"
               BackgroundColor="White"
               CornerRadius="0"
               Padding="15"
               HasShadow="True"
               Margin="0,0,0,10">

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="⬅️ Regresar"
                        x:Name="BtnRegresar"
                        BackgroundColor="#FF6600"
                        TextColor="White"
                        CornerRadius="20"
                        Padding="20,10"
                        FontAttributes="Bold"
                        Clicked="BtnRegresar_Clicked"/>

                <Button Text="🛒 Comprar Receta"
                        x:Name="BtnComprar"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        CornerRadius="20"
                        Padding="20,10"
                        FontAttributes="Bold"
                        Clicked="BtnComprar_Clicked"/>
            </HorizontalStackLayout>
        </Frame>

        <!-- CONTENIDO CON SCROLL -->
        <ScrollView Grid.Row="1" Padding="15,0">

            <VerticalStackLayout Spacing="15">

                <!-- TARJETA PRINCIPAL -->
                <Frame CornerRadius="25"
                       Padding="0"
                       HasShadow="True"
                       BackgroundColor="White">

                    <VerticalStackLayout Spacing="0">

                        <!-- IMAGEN GRANDE -->
                        <Frame
                           Padding="0"
                           HasShadow="False"
                           BackgroundColor="Transparent">
                            <Image Source="{Binding FotoUrlCompleta}"
                               Aspect="AspectFill"
                               HeightRequest="300"/>
                        </Frame>

                        <!-- CONTENIDO DE LA TARJETA -->
                        <VerticalStackLayout Spacing="20" Padding="20">

                            <!-- TÍTULO -->
                            <Label Text="{Binding titulo}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="Black"
                                   HorizontalTextAlignment="Center"/>

                            <!-- DESCRIPCIÓN -->
                            <Label Text="{Binding descripcion}"
                                   FontSize="16"
                                   TextColor="#666666"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap"/>

                            <!-- SEPARADOR -->
                            <BoxView HeightRequest="1" 
                                     BackgroundColor="#E0E0E0" 
                                     Margin="0,5"/>

                            <!-- INFO RÁPIDA: TIEMPO Y PORCIONES -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                                <!-- TIEMPO -->
                                <Frame Grid.Column="0"
                                       BackgroundColor="#FFF3E0"
                                       CornerRadius="15"
                                       Padding="15"
                                       HasShadow="False">
                                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                        <Label Text="⏱️" 
                                               FontSize="28" 
                                               HorizontalOptions="Center"/>
                                        <Label Text="{Binding tiempo_preparacion, StringFormat='{0} min'}" 
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="Black"
                                               HorizontalOptions="Center"/>
                                        <Label Text="Tiempo" 
                                               FontSize="12"
                                               TextColor="#666666"
                                               HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Frame>

                                <!-- PORCIONES -->
                                <Frame Grid.Column="1"
                                       BackgroundColor="#E8F5E9"
                                       CornerRadius="15"
                                       Padding="15"
                                       HasShadow="False">
                                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                        <Label Text="🍽️" 
                                               FontSize="28" 
                                               HorizontalOptions="Center"/>
                                        <Label Text="{Binding porciones}" 
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="Black"
                                               HorizontalOptions="Center"/>
                                        <Label Text="Porciones" 
                                               FontSize="12"
                                               TextColor="#666666"
                                               HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </Grid>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- INFORMACIÓN FINANCIERA -->
                <Frame CornerRadius="20" 
                       BackgroundColor="White" 
                       HasShadow="True" 
                       Padding="20">

                    <VerticalStackLayout Spacing="15">

                        <Label Text="💰 Información de Costos"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <!-- PRECIO DE VENTA DESTACADO -->
                        <Frame BackgroundColor="#FFF3E0"
                               CornerRadius="15"
                               Padding="15"
                               HasShadow="False">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Label Text="Precio de Venta:"
                                       FontSize="16"
                                       TextColor="#666666"
                                       VerticalOptions="Center"/>
                                <Label Text="{Binding valor_venta, StringFormat='${0:F2}'}"
                                       FontSize="32"
                                       FontAttributes="Bold"
                                       TextColor="#FF6600"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Frame>

                        <!-- GRID DE DETALLES -->
                        <Grid ColumnDefinitions="*,*" 
                              RowDefinitions="Auto,Auto,Auto" 
                              ColumnSpacing="10" 
                              RowSpacing="10">

                            <!-- COSTO -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="3">
                                <Label Text="Costo Receta" 
                                       FontSize="12" 
                                       TextColor="#999999"/>
                                <Label Text="{Binding costo_receta, StringFormat='${0:F2}'}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="Black"/>
                            </VerticalStackLayout>

                            <!-- GANANCIA -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="3">
                                <Label Text="Ganancia" 
                                       FontSize="12" 
                                       TextColor="#999999"/>
                                <Label Text="{Binding porcentaje_ganancia, StringFormat='{0:F1}%'}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#4CAF50"/>
                            </VerticalStackLayout>

                            <!-- PRECIO POR PORCIÓN -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="3">
                                <Label Text="Precio/Porción" 
                                       FontSize="12" 
                                       TextColor="#999999"/>
                                <Label Text="{Binding precio_unidad, StringFormat='${0:F2}'}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#FF6600"/>
                            </VerticalStackLayout>

                            <!-- PESO TOTAL -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="3">
                                <Label Text="Peso Total" 
                                       FontSize="12" 
                                       TextColor="#999999"/>
                                <Label Text="{Binding peso_total, StringFormat='{0:F0}g'}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="Black"/>
                            </VerticalStackLayout>

                            <!-- PESO POR PORCIÓN -->
                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="3">
                                <Label Text="Peso por Porción" 
                                       FontSize="12" 
                                       TextColor="#999999"/>
                                <Label Text="{Binding peso_porcion, StringFormat='{0:F0}g'}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="Black"/>
                            </VerticalStackLayout>

                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- INGREDIENTES -->
                <Frame CornerRadius="20" 
                       BackgroundColor="White" 
                       HasShadow="True" 
                       Padding="20">

                    <VerticalStackLayout Spacing="15">

                        <Label Text="🧂 Ingredientes"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <!-- LISTA DE INGREDIENTES -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ingredientes}" 
                                           Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Frame BackgroundColor="#F5F5F5"
                                           CornerRadius="10"
                                           Padding="12"
                                           HasShadow="False">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">

                                            <!-- NOMBRE -->
                                            <Label Grid.Column="0"
                                                   Text="{Binding nombre}" 
                                                   FontSize="16" 
                                                   FontAttributes="Bold"
                                                   TextColor="Black"
                                                   VerticalOptions="Center"/>

                                            <!-- CANTIDAD Y UNIDAD -->
                                            <Label Grid.Column="1"
                                                   FontSize="14" 
                                                   TextColor="#666666"
                                                   VerticalOptions="Center">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding cantidad}" FontAttributes="Bold"/>
                                                        <Span Text=" "/>
                                                        <Span Text="{Binding unidad_medida}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <!-- PRECIO -->
                                            <Label Grid.Column="2"
                                                   Text="{Binding precio_unitario_total, StringFormat='${0:F2}'}" 
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#FF6600"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Frame>

                <!-- INSTRUCCIONES -->
                <Frame CornerRadius="20" 
                       BackgroundColor="White" 
                       HasShadow="True" 
                       Padding="20"
                       Margin="0,0,0,15">

                    <VerticalStackLayout Spacing="15">

                        <Label Text="👨‍🍳 Instrucciones"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <Label Text="{Binding preparacion}"
                               FontSize="16"
                               TextColor="#333333"
                               LineBreakMode="WordWrap"/>

                    </VerticalStackLayout>
                </Frame>

                <!-- INFORMACIÓN DEL CREADOR -->
                <Frame CornerRadius="20" 
                       BackgroundColor="#E3F2FD" 
                       HasShadow="True" 
                       Padding="15"
                       Margin="0,0,0,20">

                    <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">

                        <VerticalStackLayout Spacing="5">
                            <Label Text="👤 Creado por"
                                   FontSize="12"
                                   TextColor="#666666"
                                   HorizontalOptions="Center"/>
                            <Label Text="{Binding id_usuario}" 
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="Black"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <BoxView WidthRequest="1" 
                                 BackgroundColor="#BDBDBD"
                                 VerticalOptions="Fill"/>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="📅 Fecha"
                                   FontSize="12"
                                   TextColor="#666666"
                                   HorizontalOptions="Center"/>
                            <Label Text="{Binding fecha_creacion, StringFormat='{0:dd/MM/yyyy}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="Black"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                    </HorizontalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>